# Default: the active coding assistant runs the repository workflow. No model
# API keys are required. Set to "api" only for unattended Vercel execution.
EDITORIAL_EXECUTION_MODE=agent

# Optional API mode. When enabled, use a different key and model for each stage.
# Anthropic can run Claude directly; OpenRouter can route DeepSeek and others.
AI_PLAN_PROVIDER=openai
AI_PLAN_MODEL=gpt-5.6-luna
AI_PLAN_API_KEY=

AI_RESEARCH_PROVIDER=openai
AI_RESEARCH_MODEL=gpt-5.6-terra
AI_RESEARCH_API_KEY=

AI_WRITER_PROVIDER=anthropic
AI_WRITER_MODEL=claude-haiku-4-5-20251001
AI_WRITER_API_KEY=

AI_VERIFY_PROVIDER=openai
AI_VERIFY_MODEL=gpt-5.6-sol
AI_VERIFY_API_KEY=

# Application and automation
ADMIN_PASSWORD=
CRON_SECRET=
GITHUB_TOKEN=
DAILY_EMAIL_TO=
DAILY_EMAIL_FROM=
GMAIL_APP_PASSWORD=
FMP_API_KEY=
NEXT_PUBLIC_GA_ID=

# Legacy direct briefing publication remains off unless explicitly enabled.
ENABLE_LEGACY_DAILY_BRIEFING=false
